{
  "name": "oxeno-backend",
  "private": true,
  "version": "0.0.0",
  "description": "Oxeno backend API service.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env server/index.js",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test",
    "lint": "eslint server tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset:tenant": "node --env-file=.env scripts/resetTenantData.js"
  },
  "dependencies": {
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
