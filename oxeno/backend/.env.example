# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# Authentication: use a randomly generated value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# PostgreSQL: set DATABASE_URL, or provide the individual POSTGRES_* values below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/oxeno
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxeno
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-password

# TLS defaults to true in production and verifies certificates by default.
# Use DATABASE_SSL_CA only when your provider supplies a custom CA certificate.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=
